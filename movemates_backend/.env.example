# Copy to movemates_backend/.env and set your own local values. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=movemates
DB_USER=movemates_user
DB_PASSWORD=replace_with_your_local_database_password

# Optional: reachable address of the development backend for profile-image URLs.
# If testing on a physical phone, use your computer's reachable LAN address.
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
